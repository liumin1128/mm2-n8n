        "jsCode": "\n// 2. 定义声音映射\nconst speakerMap = {\n  老杨: \"zh_male_dayixiansheng_v2_saturn_bigtts\",\n  小李: \"zh_female_mizaitongxue_v2_saturn_bigtts\",\n};\n\n// 3. 自定义 UUID v4 生成函数 (解决 crypto 缺失问题)\nfunction uuidv4() {\n  return \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, function (c) {\n    const r = (Math.random() * 16) | 0;\n    const v = c == \"x\" ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nconst content = JSON.parse($input.first().json.body.content)\n\n// 4. 构建输出结构\nconst result = {\n  taskId: $input.first().json.body._id || uuidv4(), // 调用自定义函数\n  inputId: $input.first().json.body.title,\n  action: 3,\n  nlpTexts: (content || []).map((item) => ({\n    text: item.text,\n    speaker:\n      speakerMap[item.speaker] || \"zh_male_dayixiansheng_v2_saturn_bigtts\",\n  })),\n  speakerInfo: {\n    randomOrder: false,\n  },\n  audioConfig: {\n    format: \"mp3\",\n    sampleRate: 24000,\n  },\n  useHeadMusic: false,\n  useTailMusic: false,\n  callbackUrl: $execution.resumeUrl,\n};\n\n// 5. 返回结果\nreturn { json: result };\n"
